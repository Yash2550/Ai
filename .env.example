# Copy this file to .env and fill in your API keys.

# Get your Recraft.ai API key from your Recraft developer settings:
RECRAFT_API_KEY=your_recraft_api_key_here

# Get your Nano Banana API key from your Nano Banana developer dashboard:
NANOBANANA_API_KEY=your_nanobanana_api_key_here

# Override the Nano Banana base URL if the domain ever changes (optional):
# NANOBANANA_BASE_URL=https://api.nanobananaapi.dev

OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Google Flow API (via useapi.net) — Nano Banana 2 Lite / 2.1 / Pro
# Get your API token at https://useapi.net/docs/start-here/setup-useapi
GOOGLE_FLOW_API_TOKEN=your_google_flow_api_token_here
# Your connected Google Flow email account
GOOGLE_FLOW_EMAIL=your_email@gmail.com
